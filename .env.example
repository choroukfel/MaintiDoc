# Copier en .env et remplacer TOUTES les valeurs (le fichier .env est ignoré par Git).
MAINTIDOC_APPROVAL_SECRET=remplacer-par-une-longue-valeur-aleatoire
MAINTIDOC_JWT_SECRET=remplacer-par-une-autre-longue-valeur-aleatoire
POSTGRES_PASSWORD=remplacer-mot-de-passe-postgres
# MinIO (facultatif) : décommenter la 1re ligne et lancer avec « --profile minio »
# MAINTIDOC_S3_ENDPOINT=minio:9000
MINIO_ROOT_USER=maintidoc
MINIO_ROOT_PASSWORD=remplacer-mot-de-passe-minio-8-caracteres-min
# Ollama installé sur la machine hôte (cas du poste de développement) :
OLLAMA_HOST=http://host.docker.internal:11434
# Modèle : qwen2.5vl:3b sur CPU, qwen2.5vl:7b recommandé sur GPU 24 Go
MAINTIDOC_VLM=qwen2.5vl:3b
